      ],
      "affected_assets": [
        "RAG Knowledge System",
        "Retrieved Context",
        "Persistent Memory",
        "Agent Planner"
      ],
      "root_cause": "Retrieved documents are admitted without sufficient source provenance, context classification, instruction isolation, or fail-closed admission controls.",
      "business_impact": "Malicious retrieval content can manipulate model behavior, persist into memory, influence agents, expose sensitive information, and support privileged execution.",
      "control_failures": [
        "RAG Source Validation",
        "Document Provenance",
        "Indirect Prompt Injection Detection",
        "Fail-Closed Context Admission",
        "Retrieved Data Minimization"
      ],
